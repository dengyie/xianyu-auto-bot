# 复制为项目根目录 .env 后填写（权限建议 600）。
# Docker Compose 会自动读取同目录 .env，用于替换 docker-compose.yml 里的 ${VAR}。
# 切勿把真实 .env 提交到 git（已在 .gitignore）。

# --- 镜像 / 部署 ---
# XIANYU_IMAGE=ghcr.io/dengyie/xianyu-auto-bot:latest
# COMPOSE_PROJECT_NAME=xianyu

# 容器内运行用户（需与 volume 属主一致）
APP_UID=1000
APP_GID=1000

# 资源上限（1GB VPS 建议偏保守）
# MEMORY_LIMIT=1024
# MEMORY_RESERVATION=256
# CPU_LIMIT=1.0
# CPU_RESERVATION=0.25

# --- 管理后台 ---
ADMIN_USERNAME=admin
# 首次初始化管理员密码；留空则随机生成并只写启动日志
ADMIN_PASSWORD=

# --- 加密 / 会话（生产务必固定；更换会导致旧 Cookie/密码不可解密）---
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_ENCRYPTION_KEY=
JWT_SECRET_KEY=

# --- HTTP API 密钥（启用对应接口时必填）---
XIANYU_REPLY_API_KEY=
CAPTCHA_CONTROL_API_KEY=
SEND_MESSAGE_API_KEY=

# --- 对外访问 / 人工滑块面板（大众 Cookie 主路径兜底）---
# Web/API 监听端口（默认 8090；人工面板 URL 会拼这个端口）
# API_PORT=8090
# 公网/局域网可达主机名或 IP（优先于 PUBLIC_IP）
# SERVER_HOST=
# PUBLIC_IP=
# 反代完整前缀时用这个（优先于 SERVER_HOST+API_PORT）
# 例: https://bot.example.com 或 https://bot.example.com:9443
# CAPTCHA_PUBLIC_BASE_URL=
# CAPTCHA_CONTROL_SCHEME=http
# 自动滑块失败后是否拉起 /api/captcha 人工面板（默认开启）
# XY_SLIDER_HUMAN_FALLBACK=true
# 人工面板等待超时/轮询（秒）
# SLIDEX_REMOTE_TIMEOUT=180
# SLIDEX_REMOTE_POLL=2
# 可选：远端 HTTP 打码（第三方 solver）；不配则跳过 remote 阶
# SLIDEX_REMOTE_URL=
# SLIDEX_REMOTE_SECRET=

# --- 可选调试 ---
# ENABLE_VNC=false
# VNC_PASSWORD=
# LOG_LEVEL=INFO
# DEBUG=false

# --- GHCR 登录（给 docker-deploy.sh login-ghcr / pull 用，不是 compose 变量）---
# 推荐不写进 .env，而用：
#   export GHCR_TOKEN=<PAT read:packages>
# 或文件（0600）: ~/.config/xianyu/ghcr_token
# GHCR_TOKEN=
# GHCR_USER=dengyie
